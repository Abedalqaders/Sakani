{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Information"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5001;Database=Sakani;Username=MyUser;Password=MyPassword1234;"
    },
    "Jwt": {
        "Key": "your-super-secret-jwt-key-must-be-at-least-32-characters-long-for-hs256-algorithm",
        "Issuer": "SakaniApp",
        "Audience": "SakaniUsers",
        "ExpirationMinutes": 60
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:3000",
            "http://localhost:5173",
            "https://yourdomain.com"
        ]
    },
    "Cloudinary": {
        "CloudName": "your-cloudinary-cloud-name",
        "ApiKey": "your-cloudinary-api-key",
        "ApiSecret": "your-cloudinary-api-secret"
    },
    "ApplicationSettings": {
        "AppName": "Sakani",
        "AppVersion": "1.0.0"
    }
}
